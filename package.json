{
  "name": "scriptorium",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "description": "Generate illustrated, fully referenced research books and export KDP-ready print and web editions.",
  "scripts": {
    "build": "tsx src/cli/main.ts build",
    "build:all": "tsx src/cli/main.ts build-all",
    "demo": "tsx src/cli/main.ts build examples/rc-circuits",
    "cli": "tsx src/cli/main.ts",
    "generate": "tsx src/cli/main.ts generate",
    "figures": "tsx examples/rc-circuits/figures.ts",
    "assets": "tsx scripts/render_assets.ts",
    "assets:check": "tsx scripts/render_assets.ts --check",
    "test": "vitest run",
    "test:equations": "node scripts/pytest.mjs",
    "typecheck": "tsc -p .",
    "verify-refs": "tsx src/cli/main.ts verify-refs examples/rc-circuits/book.json",
    "app": "vite --config web/vite.config.ts",
    "app:build": "vite build --config web/vite.config.ts",
    "icons": "tsx scripts/render_icon.ts && tauri icon assets/rendered/icon-1024.png && node -e \"for (const d of ['android','ios']) require('fs').rmSync('src-tauri/icons/'+d,{recursive:true,force:true})\"",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/api": "2.12.1",
    "citeproc": "2.4.63",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "jsdom": "30.1.1",
    "katex": "0.18.10",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "source-sans": "3.52.0",
    "source-serif": "4.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/jsdom": "30.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "epubcheck-static": "4.0.0-v5.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
